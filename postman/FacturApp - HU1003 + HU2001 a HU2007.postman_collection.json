    {
      "name": "00 - Autenticación y roles",
      "item": [
        {
          "name": "Registrar usuario (queda PENDING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creado o validación esperada',()=>pm.expect([201,400]).to.include(pm.response.code));\nif(pm.response.code===201){const j=pm.response.json();pm.environment.set('userId',j.id);pm.environment.set('newUserEmail',j.email);}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"1234567891011\",\n  \"name\": \"Usuario de prueba 2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "register"
              ]
            },
            "description": "Registra usuario. El rol se asigna automáticamente como PENDING."
          },
          "response": []
        },
        {
          "name": "Iniciar sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto',()=>pm.response.to.have.status(200));\nif(pm.response.code===200){const j=pm.response.json();pm.environment.set('token',j.access_token);pm.environment.set('loggedUserId',j.user.id);pm.environment.set('loggedUserRole',j.user.role);}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@facturapp.com\",\n  \"password\": \"7891011\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "login"
              ]
            },
            "description": "Al iniciar sesión guarda access_token en la variable token."
          },
          "response": []
        },
        {
          "name": "Asignar rol a usuario (solo ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Respuesta de asignación',()=>pm.expect([200,400,401,403,404]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"SELLER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{userId}}",
                "role"
              ]
            },
            "description": "Cambia el rol del usuario indicado. El token debe pertenecer a ADMIN."
          },
          "response": []
        }
      ]
